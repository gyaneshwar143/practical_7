#include <iostream>
#include <vector>
#include <climits>
using namespace std;

int main() {
    int coins[] = {1, 2, 5};

    int n = 3;
    int amount = 11;
    vector<int> dp(amount + 1, INT_MAX);
    dp[0] = 0;
    for (int i = 1; i <= amount; i++) {
        for (int j = 0; j < n; j++) {

            if (coins[j] <= i && dp[i - coins[j]] != INT_MAX) {

                dp[i] = min(dp[i], dp[i - coins[j]] + 1);

            }
        }
    }
    cout << "Coins: ";

    for (int i = 0; i < n; i++) {
        cout << coins[i] << " ";
    }

    cout << "\nAmount: " << amount << endl;

    if (dp[amount] == INT_MAX) {
        cout << "Change cannot be made." << endl;
    }
    else {
        cout << "Minimum coins required: "
             << dp[amount] << endl;
    }

    return 0;
}

output
Coins: 1 2 5
Amount: 11
Minimum coins required: 3
